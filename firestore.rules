rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Native auth profile: username and reservation must be created atomically.
    function validUsername(name) {
      return name is string && name.matches('^[a-z][a-z0-9_]{2,19}$');
    }
    match /accountProfiles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, update, delete: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && validUsername(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
    }
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow list, update, delete: if false;
      allow create: if request.auth != null && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.username == name;
    }
    // Client profile: uid/name/createdAt/updatedAt required. Email, photoUrl and
    // authProviders are metadata only. Membership and consent are server-owned.
    function isValidUser(data, uid) {
      return data.keys().hasAll(['uid', 'name', 'createdAt', 'updatedAt']) &&
        data.uid == uid && data.name is string && data.name.size() <= 100 &&
        data.createdAt is timestamp && data.updatedAt is timestamp &&
        (!('email' in data) || data.email == null ||
          (data.email is string && data.email.size() <= 320)) &&
        (!('photoUrl' in data) || data.photoUrl == null ||
          (data.photoUrl is string && data.photoUrl.size() <= 2048 && data.photoUrl.matches('https://.*'))) &&
        (!('authProviders' in data) ||
          (data.authProviders is list && data.authProviders.size() <= 10));
    }
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    match /users/{uid} {
      allow read: if verified() && request.auth.uid == uid;
      allow create: if verified() && request.auth.uid == uid &&
        isValidUser(request.resource.data, uid) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'photoUrl', 'authProviders', 'createdAt', 'updatedAt'
        ]) && request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if verified() && request.auth.uid == uid &&
        isValidUser(request.resource.data, uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photoUrl', 'updatedAt'
        ]) && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
  }
}

