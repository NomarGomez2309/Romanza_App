rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Native auth profile: username and reservation must be created atomically.
    function validUsername(name) {
      return name is string && name.matches('^[a-z][a-z0-9_]{2,19}$');
    }
    match /accountProfiles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, update, delete: if false;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && validUsername(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
    }
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow list, update, delete: if false;
      allow create: if request.auth != null && validUsername(name)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/accountProfiles/$(request.auth.uid)).data.username == name;
    }
  }
}

